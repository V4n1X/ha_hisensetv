    {
      "st": "urn:schemas-upnp-org:device:MediaRenderer:1",
      "manufacturer": "hisense*"
    },
    {
      "manufacturer": "hisense*",
      "modelDescription": "*mqttport*"
    }
  ],
  "version": "1.0.0"
}
